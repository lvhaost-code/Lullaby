// Lullaby admin — database schema
// Postgres (Neon), both for local dev and production.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("staff") // "owner" | "staff"
  createdAt    DateTime @default(now())
}

model Product {
  id           String         @id @default(cuid())
  code         String         @unique
  category     String // "Váy đầm" | "Giày" | "Túi" | "Phụ kiện"
  brand        String?
  costPrice    Int?
  rentPrice3   Int?
  rentPriceDay Int?
  size         String?
  deposit      String?
  notes        String?
  status       String         @default("available") // available | cleaning | damaged | retired
  thumbUrl     String? // small (~160px) copy of the cover photo, for list/grid views — see src/lib/thumbnail.ts
  photos       ProductPhoto[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([category])
  @@index([status])
}

// Multiple photos per product, shown as a gallery on the public catalog.
// sortOrder 0 is the cover photo used in list/card thumbnails.
model ProductPhoto {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String // resized dataURL, or Vercel Blob URL later
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// Customer identity is derived from (name, phone) on orders rather than a
// separate table — matches the validated prototype logic (group by phone
// in the Customers tab). Revisit if the shop wants customer-level fields
// (loyalty notes, blacklist...) that don't belong on individual orders.
model Order {
  id              String      @id @default(cuid())
  customerName    String
  customerPhone   String?
  invoiceDate     String // ISO date
  pickupDate      String // ISO date
  returnDate      String // ISO date
  depositMethod   String? // CCCD | GPLX | Tiền mặt | Chuyển khoản
  depositAmount   Int?
  paymentCash     Int?
  paymentTransfer Int?
  note            String?
  status          String      @default("Đã đặt") // Đã đặt | Đang thuê | Đã trả | Đã hủy
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerPhone])
  @@index([status])
}

// No FK to Product: mirrors the prototype, where an item is just a product
// code + a snapshotted rent price at booking time, and stays on the order
// even if the product is later edited or deleted.
model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  code       String
  rentPrice3 Int?

  @@index([orderId])
  @@index([code])
}

// A customer-submitted pre-booking from the public catalog (Giai đoạn 2).
// Not a real reservation yet — staff call/Zalo the customer to confirm
// availability and details, then either turn it into a real Order
// ("confirmed") or dismiss it.
model BookingRequest {
  id            String               @id @default(cuid())
  customerName  String
  customerPhone String
  pickupDate    String
  returnDate    String
  note          String?
  status        String               @default("pending") // pending | confirmed | dismissed
  items         BookingRequestItem[]
  createdAt     DateTime             @default(now())

  @@index([status])
}

model BookingRequestItem {
  id        String         @id @default(cuid())
  request   BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  code      String

  @@index([requestId])
}

// Daily snapshot so an accidental delete or bad edit can be recovered from
// further back than Neon's 24h point-in-time-recovery window.
//
// kind "metadata": products/orders/booking-requests/users, no photos, no
// password hashes — cheap, kept 30 days deep.
// kind "full": same, plus every product photo — expensive (photos are the
// bulk of DB storage), so kept only a few days deep. Needed because photos
// added by hand in the app (not from the shop's Excel) have no other copy.
model Backup {
  id        String   @id @default(cuid())
  kind      String   @default("metadata")
  createdAt DateTime @default(now())
  data      String // JSON snapshot

  @@index([kind, createdAt])
}
